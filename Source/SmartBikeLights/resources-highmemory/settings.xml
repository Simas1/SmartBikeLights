                <listEntry value="2">@Strings.Secondary</listEntry>
                <listEntry value="3">@Strings.Tertiary</listEntry>
            </settingConfig>
        </setting>
        <setting propertyKey="@Properties.LC" title="@Strings.LC">
            <settingConfig type="alphaNumeric" maxLength="100000" />
