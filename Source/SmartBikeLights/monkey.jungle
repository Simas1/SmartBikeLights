# Supported devices: Edge 1050/850/550/1040/840/540 and Forerunner 965.
project.manifest = manifest.xml
excludeBase=widget;buttonPanel;watchPanel
project.optimization = 2
project.typecheck = 0
base.sourcePath = source;source-common;source-generated;tests
rectangleHighResolution = $(excludeBase);nonTouchScreen;lowMemory;noLightButtons;round;semioctagon;settings;monochromeScreen;mediumResolution
rectangleButtonPanel = widget;touchScreen;lowMemory;noLightButtons;round;semioctagon;monochromeScreen;highResolution;noButtonPanel
rectangleButtonPanelHighResolution = widget;touchScreen;lowMemory;noLightButtons;round;semioctagon;monochromeScreen;mediumResolution;noButtonPanel
cardResources = resources/properties.xml;resources/settings.xml;resources/fitfields.xml;resources/data.xml;resources/strings.xml;resources-highmemory/panel-icons.xml;resources-highmemory/build-info.xml;resources-highmemory/strings.xml;resources-highmemory/properties.xml;resources-highmemory/settings.xml
rectangle.excludeAnnotations = $(excludeBase);nonTouchScreen;lowMemory;noLightButtons;round;semioctagon;settings;monochromeScreen;highResolution
round.excludeAnnotations = $(excludeBase);touchScreen;lowMemory;noLightButtons;rectangle;semioctagon;monochromeScreen;highResolution
base.excludeAnnotations = $(rectangle.excludeAnnotations)
edge540.excludeAnnotations = $(rectangleButtonPanel)
edge540.resourcePath = $(cardResources);resources-edge540
edge1040.resourcePath = $(edge1040.resourcePath);resources-highmemory;resources-touchscreen
edge840.resourcePath = $(edge840.resourcePath);resources-highmemory;resources-touchscreen
edge1050.resourcePath = resources-highmemory;$(edge1050.resourcePath)
edge1050.excludeAnnotations = $(rectangleHighResolution)
edge850.resourcePath = resources-highmemory;$(edge850.resourcePath)
edge850.excludeAnnotations = $(rectangleHighResolution)
edge550.resourcePath = $(cardResources);resources-edge550
edge550.excludeAnnotations = $(rectangleButtonPanelHighResolution)
fr965.excludeAnnotations = widget;buttonPanel;noWatchPanel;nonTouchScreen;lowMemory;noLightButtons;rectangle;semioctagon;monochromeScreen;mediumResolution
fr965.resourcePath = $(fr965.resourcePath);resources-highmemory
